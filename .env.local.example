# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM APIs (6 motores)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# Paralelismo da auditoria (prompts × motores). Default: 5
AUDIT_CONCURRENCY=8

# Web search / grounding nos motores de audit. Replica o que o cliente vê
# quando pergunta a uma AI com pesquisa ao vivo (claude, chatgpt, gemini, grok).
# Default: ligado em todos os tiers.
#   AUDIT_WEB_SEARCH=0                        → desliga em todo o lado
#   AUDIT_WEB_SEARCH_TIERS=diagnostic,premium → liga só nos tiers pagos
#                                               (o free fica sem custo de pesquisa)
#   AUDIT_SEARCH_TIMEOUT_MS=120000            → timeout por chamada grounded (mais lenta)
AUDIT_WEB_SEARCH=1
AUDIT_WEB_SEARCH_TIERS=
AUDIT_SEARCH_TIMEOUT_MS=120000

# Email (Resend)
RESEND_API_KEY=
# Remetente. Para enviar a clientes externos, o domínio tem de estar
# verificado no Resend. Ex.: "destaque.ai <contacto@destaque.ai>"
RESEND_FROM=

# App
NEXT_PUBLIC_APP_URL=https://admin.destaque.ai
NEXT_PUBLIC_PROPOSAL_URL=https://destaque.ai

# Admin (único user permitido)
ADMIN_EMAIL=contacto@destaque.ai

# Cron (protege /api/cron/* — definido automaticamente pelo Vercel Cron)
CRON_SECRET=
